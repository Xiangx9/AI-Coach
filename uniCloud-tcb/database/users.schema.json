{
  "bsonType": "object",
  "required": [
    "user_id",
    "nickname",
    "createTime"
  ],
  "permission": {
    "read": "doc.user_id == auth.uid",
    "create": true,
    "update": "doc.user_id == auth.uid",
    "delete": false
  },
  "properties": {
    "user_id": {
      "bsonType": "string",
      "description": "UniCloud 用户ID"
    },
    "nickname": {
      "bsonType": "string",
      "description": "用户昵称"
    },
    "avatar": {
      "bsonType": "string"
    },
    "gender": {
      "bsonType": "string",
      "enum": [
        "male",
        "female",
        "unknown"
      ]
    },
    "age": {
      "bsonType": "int"
    },
    "height": {
      "bsonType": "double"
    },
    "weight": {
      "bsonType": "double"
    },
    "bodyFat": {
      "bsonType": "double"
    },
    "goal": {
      "bsonType": "string",
      "enum": [
        "fat_loss",
        "muscle_gain",
        "body_shape",
        "endurance"
      ]
    },
    "trainPlace": {
      "bsonType": "string",
      "enum": [
        "home",
        "gym"
      ]
    },
    "vip": {
      "bsonType": "bool"
    },
    "createTime": {
      "bsonType": "timestamp"
    },
    "realName": {
      "bsonType": "string",
      "description": "真实姓名"
    },
    "updateTime": {
      "bsonType": "timestamp"
    }
  }
}
