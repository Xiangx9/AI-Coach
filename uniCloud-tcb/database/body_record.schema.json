{
  "bsonType": "object",
  "required": ["user_id", "weight", "createTime"],
  "permission": { "read": "doc.user_id == auth.uid", "create": true, "update": "doc.user_id == auth.uid", "delete": "doc.user_id == auth.uid" },
  "properties": {
    "user_id": { "bsonType": "string" },
    "weight": { "bsonType": "double" },
    "bodyFat": { "bsonType": "double" },
    "chest": { "bsonType": "double" },
    "waist": { "bsonType": "double" },
    "arm": { "bsonType": "double" },
    "createTime": { "bsonType": "timestamp" }
  }
}
