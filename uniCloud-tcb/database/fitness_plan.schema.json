{
  "bsonType": "object",
  "required": [
    "user_id",
    "title",
    "goal",
    "daysPerWeek",
    "plan",
    "createTime"
  ],
  "permission": {
    "read": "doc.user_id == auth.uid",
    "create": true,
    "update": "doc.user_id == auth.uid",
    "delete": "doc.user_id == auth.uid"
  },
  "properties": {
    "user_id": {
      "bsonType": "string"
    },
    "title": {
      "bsonType": "string"
    },
    "goal": {
      "bsonType": "string"
    },
    "daysPerWeek": {
      "bsonType": "int"
    },
    "plan": {
      "bsonType": "array"
    },
    "createTime": {
      "bsonType": "timestamp"
    },
    "trainPlace": {
      "bsonType": "string",
      "enum": [
        "home",
        "gym"
      ]
    },
    "dietSnapshot": {
      "bsonType": "object"
    },
    "aiAdvice": {
      "bsonType": "string"
    }
  }
}
